<Window x:Class="DepthVideo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DepthVideo.App.Converters"
        Title="深度视频转换器" Height="760" Width="1080" MinHeight="680" MinWidth="920"
        WindowStartupLocation="CenterScreen" Background="#F2F5F3"
        FontFamily="Segoe UI, Microsoft YaHei UI" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#176B52"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D8E0DC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#65716D"/>
        <converters:EnumDisplayConverter x:Key="EnumDisplayConverter"/>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCD7D2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#23312D"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="44"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C8D3CE"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#C8D3CE"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="{StaticResource AccentBrush}" CornerRadius="5">
                        <TextBlock Text="D" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="深度视频转换器" FontSize="18" FontWeight="SemiBold" Foreground="#17231F"/>
                        <TextBlock Text="本地 AI 深度处理" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Padding="12,7" BorderBrush="#BAD0C6" BorderThickness="1" CornerRadius="4" Background="#EAF3EF" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DeviceStatus}" Foreground="#245D4B" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Background="White" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="输入视频" FontSize="15" FontWeight="SemiBold" Foreground="#25332F"/>
                                <TextBlock Text="{Binding InputName}" Margin="0,9,0,0" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding InputDetails}" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="选择视频" Click="SelectVideo_Click" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Grid.Row="2" Height="190" BorderBrush="#AFC4BA" BorderThickness="1" CornerRadius="5" Background="#F7FAF8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="＋" FontSize="35" Foreground="#39755F" HorizontalAlignment="Center"/>
                                <TextBlock Text="拖入视频文件" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="MP4 · MOV · MKV · AVI · WebM" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Background="White" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="处理状态" FontSize="15" FontWeight="SemiBold"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding StatusTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#24332E"/>
                                <TextBlock Text="{Binding StatusDetail}" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ProgressValue, Mode=OneWay, StringFormat={}{0:0}%}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="4">
                            <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="10" Foreground="{StaticResource AccentBrush}" Background="#E4EBE7" BorderThickness="0"/>
                            <Grid Margin="0,9,0,0">
                                <TextBlock Text="{Binding SpeedText}" Foreground="{StaticResource MutedBrush}"/>
                                <Button Content="打开输出目录" Click="OpenFolder_Click" HorizontalAlignment="Right" Padding="10,0" MinHeight="30"/>
                            </Grid>
                            <Expander Header="处理日志" Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}">
                                <ListBox ItemsSource="{Binding Logs}" Height="110" Margin="0,8,0,0" FontFamily="Consolas" FontSize="11" BorderBrush="{StaticResource LineBrush}"/>
                            </Expander>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Background="#FBFCFB" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="转换设置" FontSize="17" FontWeight="SemiBold" Foreground="#21302B"/>
                        <TextBlock Text="默认设置适合大多数视频" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="推理设备" Margin="0,0,0,7" Foreground="#46534F"/>
                        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="处理质量" Margin="0,0,0,7" Foreground="#46534F"/>
                        <ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="6">
                        <TextBlock Text="深度方向" Margin="0,0,0,7" Foreground="#46534F"/>
                        <ComboBox ItemsSource="{Binding PolarityOptions}" SelectedItem="{Binding SelectedPolarity}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="8">
                        <TextBlock Text="视频编码器" Margin="0,0,0,7" Foreground="#46534F"/>
                        <ComboBox ItemsSource="{Binding EncoderOptions}" SelectedItem="{Binding SelectedEncoder}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="10">
                        <TextBlock Text="输出文件" Margin="0,0,0,7" Foreground="#46534F"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="浏览" Click="SelectOutput_Click"/>
                        </Grid>
                    </StackPanel>
                    <Grid Grid.Row="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="开始转换" Style="{StaticResource PrimaryButton}" Click="Start_Click" IsEnabled="{Binding CanStart}"/>
                        <Button Grid.Column="2" Content="停止" Click="Stop_Click" IsEnabled="{Binding IsBusy}" MinWidth="78"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#E9EFEC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,11">
            <TextBlock Text="Depth Anything V2 Small · ONNX Runtime DirectML · FFmpeg" Foreground="#66736E" FontSize="11"/>
        </Border>
    </Grid>
</Window>
